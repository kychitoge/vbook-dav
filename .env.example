# ==============================================================================
# vbook-dav Configuration Template
# ==============================================================================
# Copy this file to .env and customize the parameters:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network & Storage
# ------------------------------------------------------------------------------
# Listening port for the WebDAV gateway (default: :8080)
PORT=:8080

# Local directory where files and backups will be stored (default: ./data)
DATA_DIR=./data

# Subdirectory name for vBook backups (default: vbook_backup)
DAV_BACKUP_FOLDER=vbook_backup

# ------------------------------------------------------------------------------
# 2. WebDAV Authentication
# ------------------------------------------------------------------------------
# Credentials used by the vBook mobile application
DAV_USER=vbook
DAV_PASS=vbook123

# Set to true to reject all mutating operations (PUT, DELETE, MKCOL, MOVE)
READ_ONLY=false

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Cloud Replication (Optional)
# ------------------------------------------------------------------------------
# If left empty, the server operates safely in local-only mode.
# If configured, PUT and DELETE operations replicate asynchronously to Cloudflare R2.
#
# S3 API endpoint provided by Cloudflare R2:
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Cloudflare R2 Access Key ID
R2_ACCESS_KEY=

# Cloudflare R2 Secret Access Key
R2_SECRET_KEY=

# Destination bucket name in Cloudflare R2
R2_BUCKET=

# ------------------------------------------------------------------------------
# 4. Discord Webhook Notifications (Optional)
# ------------------------------------------------------------------------------
# Discord incoming webhook URL to receive sync alerts and server status updates.
# If left empty, notifications are disabled.
DISCORD_WEBHOOK_URL=
